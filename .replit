# Best-effort starting point for importing this project into Replit — written without
# access to a live Repl to verify against, so treat it as a draft to adjust in Replit's
# own Deployments UI rather than a guaranteed-correct config. See CLAUDE.md.
#
# Workspace: `Run` starts the Astro dev server, bound to 0.0.0.0 so Replit's webview
# can reach it (localhost-only would not be visible from outside the container).
run = "npm run dev -- --host 0.0.0.0 --port 4321"
entrypoint = "src/pages/index.astro"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 4321
externalPort = 80

# Deployment: a Static Deployment is the right fit here — this is a prebuilt Astro
# site (plus the Sveltia CMS's static admin/ files), not a long-running server.
# `postbuild` (already in package.json) generates the Pagefind search index as part
# of `npm run build`, so no separate step is needed here.
[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"
