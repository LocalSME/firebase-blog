---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, getCategories } from '../lib/posts';
import { withBase } from '../lib/url';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME, AUTHOR_BIO, FEATURES } from '../consts';

const posts = await getPosts();
const latest = posts.slice(0, 8);
const categories = getCategories(posts);
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="hero">
    <p class="eyebrow">{SITE_TITLE}</p>
    <h1>Writing about the work, one post at a time.</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  {
    latest.length > 0 && (
      <section class="section" aria-labelledby="latest-heading">
        <div class="section-head">
          <h2 id="latest-heading">Latest</h2>
          <a class="read-more" href={withBase('/blog/')}>
            All posts
          </a>
        </div>
        <ul class="post-list">
          {latest.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      </section>
    )
  }

  {
    categories.length > 0 && (
      <section class="section" aria-labelledby="categories-heading">
        <div class="section-head">
          <h2 id="categories-heading">Browse by category</h2>
        </div>
        <ul class="tag-list">
          {categories.map((category) => (
            <li>
              <a class="pill" href={withBase(`/category/${category.slug}/`)}>
                {category.name} ({category.count})
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section" aria-labelledby="author-heading">
    <div class="section-head">
      <h2 id="author-heading">About {AUTHOR_NAME}</h2>
    </div>
    <p class="lead" style="max-width: 60ch;">{AUTHOR_BIO}</p>
    {
      FEATURES.about && (
        <p style="margin-top: 1rem;">
          <a class="read-more" href={withBase('/about/')}>More about this blog</a>
        </p>
      )
    }
  </section>
</BaseLayout>
