---
import { SITE_TITLE, SOCIAL_LINKS, FEATURES } from '../consts';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="comment-line">
      <span aria-hidden="true">#</span> © {year} {SITE_TITLE}. Built with Astro.
    </p>

    <ul class="footer-links">
      <li><a href={withBase('/blog/')}>blog</a></li>
      {FEATURES.about && (
        <li>
          <a href={withBase('/about/')}>about</a>
        </li>
      )}
      {FEATURES.contact && (
        <li>
          <a href={withBase('/contact/')}>contact</a>
        </li>
      )}
      <li><a href={withBase('/rss.xml')}>rss</a></li>
      {
        SOCIAL_LINKS.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
